[Unit]
Description=AE Code server

[Service]
Type=simple
ExecStart=@PREFIX@/ae-code serve --host 0.0.0.0 --port 3773 --no-browser
# Lets a client install new releases (Settings -> About, the update dialog): the server then runs
# under a small supervisor that restarts it from ~/.ae/updates. Delete this line to turn that off.
Environment=AECODE_SELF_UPDATE=true
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Optional overrides, one KEY=value per line (extra PATH entries, AECODE_HOME, provider keys, ...).
EnvironmentFile=-%E/ae-code/env
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
